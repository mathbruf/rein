      </Placemark>
      <Placemark>
        <name>Trolltjønn</name>
        <description>Ga et eventyrlig fiske på 50/60 tallet etter å ha vært fiskeløst. Noe preget av tett bestand i dag.</description>
        <styleUrl>#icon-1573-0288D1</styleUrl>
        <Point>
