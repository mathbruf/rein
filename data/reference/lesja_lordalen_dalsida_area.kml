            9.0657806,62.3470599,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Drugshøtjønnin</name>
        <description>Tett bestand av ørret med en og annen større fisk</description>
        <styleUrl>#icon-1573-0288D1</styleUrl>
        <Point>
          <coordinates>
            9.1145325,62.3344693,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Langvatnet</name>
        <description>Et av Lesjas topp 3 garnvatn. Garnfiske forbeholdt innenbygdsboende. Stor vatn med en tynn  bestand av ørret i meget bra hold. Årlige fiskeutsettinger for å opprettholde fiskebestand</description>
        <styleUrl>#icon-1573-0288D1</styleUrl>
        <Point>
