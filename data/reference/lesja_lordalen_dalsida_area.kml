        <name>Valåvatnet</name>
        <description>Bra bestand av ørret i god kondisjon. </description>
        <styleUrl>#icon-1573-0288D1</styleUrl>
        <Point>
          <coordinates>
            8.4711455,62.1430513,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Salhøtjønna</name>
        <description>Bra ørretbestand i alle vatna. Settes jevnlig ut fisk her. Fisk i bra kondisjon og størrelse.</description>
        <styleUrl>#icon-1573-0288D1</styleUrl>
        <Point>
          <coordinates>
            8.9854431,62.3462632,0
